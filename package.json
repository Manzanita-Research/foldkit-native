{
  "name": "foldkit-native",
  "version": "0.1.0-test.2",
  "private": true,
  "type": "module",
  "description": "FoldKit apps drawn natively by GPUI, in-process, through gpuix.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Manzanita-Research/foldkit-native"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "import": "./dist/primitives.js",
      "default": "./dist/primitives.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "default": "./dist/theme.js"
    },
    "./style": {
      "types": "./dist/style.d.ts",
      "import": "./dist/style.js",
      "default": "./dist/style.js"
    }
  },
  "scripts": {
    "gallery": "bun examples/gallery.ts",
    "example": "bun examples/open.ts",
    "demo": "bun examples/themes.ts",
    "counter": "bun examples/counter.ts",
    "css": "bun scripts/css.ts",
    "record": "bun scripts/record.ts",
    "typecheck": "tsc --noEmit",
    "check:package-notices": "node --test --test-concurrency=1 test/package-notices.test.mjs",
    "test": "bun test",
    "changeset": "changeset",
    "version:packages": "node scripts/release.mjs version",
    "release:github": "node scripts/release.mjs publish",
    "check:release": "node --test scripts/release.test.mjs",
    "build": "node scripts/build-packages.mjs",
    "prepack": "npm run build",
    "pack:packages": "node scripts/pack-packages.mjs",
    "check:packages": "node scripts/check-packages.mjs"
  },
  "peerDependencies": {
    "effect": "4.0.0",
    "foldkit": "0.165.0"
  },
  "dependencies": {
    "@gpuix/native": "0.10.0",
    "happy-dom": "20.14.5"
  },
  "optionalDependencies": {
    "@gpuix/native-darwin-arm64": "0.10.0",
    "@gpuix/native-linux-x64-gnu": "0.10.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@effect/platform-browser": "4.0.0",
    "@foldkit/ui": "0.165.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/bun": "1.3.5",
    "clsx": "2.1.1",
    "effect": "4.0.0",
    "foldkit": "0.165.0",
    "fractional-indexing": "4.0.0",
    "lightningcss": "1.33.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
