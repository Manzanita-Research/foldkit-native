{
  "name": "foldkit-gpuix",
  "version": "0.1.0-test.2",
  "private": true,
  "type": "module",
  "description": "A FoldKit adapter for gpuix: FoldKit's view patches gpuix's GPUI tree directly, with GPUI's own focus, scrolling and text input. The bindings layer; looks live in a UI library on top.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "@gpuix/native": "0.10.0",
    "effect": "4.0.0",
    "foldkit": "0.165.0",
    "foldkit-native": "0.1.0-test.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "LICENSE",
    "README.md",
    "CAPABILITIES.md",
    "EVENTS.md",
    "MIGRATING.md"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/build-packages.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Manzanita-Research/foldkit-native",
    "directory": "packages/foldkit-gpuix"
  }
}
