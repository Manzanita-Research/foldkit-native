{
  "name": "@foldkit-native/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Themeable FoldKit components (button, input, textarea, text field, checkbox, switch, radio group, tabs, disclosure, scroll area, listbox, select, dialog) for FoldKit on gpuix, and the web. Behaviour follows WAI-ARIA and Base UI; looks come from a token theme.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "effect": "4.0.0",
    "foldkit": "0.165.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/build-packages.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Manzanita-Research/foldkit-native",
    "directory": "packages/ui"
  }
}
